{
  "name": "@companion-kit/core",
  "version": "0.1.0",
  "description": "Portable sprite companions, character packs and agent events for the web",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./characters": {
      "types": "./dist/characters/index.d.ts",
      "import": "./dist/characters.js"
    },
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "NOTICE.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./tests/core.test.ts",
    "check": "bun run typecheck && bun run test",
    "demo:build": "bun scripts/build-demo.mjs",
    "test:browser": "bun tests/browser.mjs",
    "test:package": "bun tests/package.mjs",
    "artwork": "python3 artwork/generate.py && bun artwork/rasterize.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.9",
    "playwright": "^1.63.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.8.3",
    "vue": "^3.5.21"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "bun@1.3.14"
}
